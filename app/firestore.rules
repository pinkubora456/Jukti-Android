rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Allow owners full access based on email
    function isOwnerEmail() {
      return request.auth != null && request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null &&
             request.auth.token.email.matches('(?i)(juktieducation@gmail\\.com|borapinku151@gmail\\.com)');
    }

    function isUser(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && 
          request.auth.token.email.replace("@", "_at_").replace(".", "_dot_").lower() == userId)
      );
    }

    // --- User-owned data ---
    match /users/{userId} {
      // Allow users to read and write their own documents, allow owners full access
      allow read, write: if isUser(userId) || isOwnerEmail();
      
      match /entitlements/{entitlementId} {
        allow read: if isUser(userId) || isOwnerEmail();
        allow write: if isOwnerEmail();
      }
      
      match /purchases/{purchaseId} {
        allow read: if isUser(userId) || isOwnerEmail();
        allow write: if isOwnerEmail();
      }
      
      match /purchaseRequests/{requestId} {
        allow read: if isUser(userId) || isOwnerEmail();
        allow create: if isUser(userId);
        allow update, delete: if isOwnerEmail();
      }
      
      match /question_progress/{progressId} {
        allow read, write: if isUser(userId) || isOwnerEmail();
      }
      
      match /entitlement_history/{historyId} {
        allow read: if isUser(userId) || isOwnerEmail();
        allow write: if isOwnerEmail();
      }
    }
    
    // --- Application-owned data ---
    // Customers can read questions, but only Admins can create/edit them.
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /mock_tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /study_notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /exam_updates/{updateId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /faqs/{faqId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /subjects_chapters/{scId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /pending_requests/{reqId} {
      allow read, write: if isOwnerEmail();
    }
    
    match /activity_logs/{logId} {
      allow read, write: if isOwnerEmail();
    }
    
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }
    
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isOwnerEmail());
      allow write: if isOwnerEmail();
    }
    
    match /leaderboard/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwnerEmail();
    }

    match /firestore_sync_test/{userId} {
      allow read, write: if isUser(userId);
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
